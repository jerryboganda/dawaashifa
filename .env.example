# ==============================================================================
# DAWAA PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database (PostgreSQL 17)
DATABASE_URL=postgresql://dawaa:dawaa_password@localhost:5432/dawaa
DATABASE_MAX_CONNECTIONS=20

# Cache & Locks (Redis 7)
REDIS_URL=redis://localhost:6379

# Event Stream & Message Bus (NATS JetStream)
NATS_URL=nats://localhost:4222

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadminpassword
S3_BUCKET_PRESCRIPTIONS=dawaa-prescriptions
S3_BUCKET_PAYMENT_PROOFS=dawaa-payment-proofs
S3_BUCKET_DELIVERY_POD=dawaa-delivery-pod
S3_BUCKET_INVOICES=dawaa-invoices

# Server & HTTP API
PORT=8080
HOST=0.0.0.0
APP_ENV=development
JWT_SECRET=super_secret_dawaa_jwt_key_at_least_32_bytes_long

# AI Gateway (External GPU Host / OpenAI-compatible API)
AI_BASE_URL=http://localhost:8000
AI_API_KEY=dummy_ai_key
AI_INTENT_MODEL=qwen3-instruct
AI_RX_OCR_MODEL=qwen3-vl
AI_STT_MODEL=whisper-large-v3
AI_EMBED_MODEL=bge-m3

# WhatsApp Channel Configurations
# Cloud API
WA_CLOUD_API_VERSION=v20.0
WA_CLOUD_PHONE_NUMBER_ID=123456789012345
WA_CLOUD_WABA_ID=123456789012345
WA_CLOUD_ACCESS_TOKEN=dummy_cloud_access_token
WA_WEBHOOK_VERIFY_TOKEN=dummy_verify_token
WA_WEBHOOK_APP_SECRET=dummy_app_secret

# FBR Tax & POS Integration
FBR_POS_ENDPOINT=https://fbr-pos-sandbox.gov.pk/api/v1/invoice
FBR_POS_BEARER_TOKEN=dummy_fbr_token

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
RUST_LOG=info,dawaa_core=debug,dawaa_db=debug
