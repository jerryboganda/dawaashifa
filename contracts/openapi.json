    "/webhooks/whatsapp/{channel_id}": {
      "get": {
        "tags": [
          "Webhooks"
        ],
        "operationId": "verify_webhook_challenge",
        "parameters": [
          {
            "name": "channel_id",
            "in": "path",
            "description": "Channel ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "hub.mode",
            "in": "query",
            "description": "Hub mode",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "hub.verify_token",
            "in": "query",
            "description": "Hub verify token",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "hub.challenge",
            "in": "query",
            "description": "Hub challenge",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Webhook challenge verified",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Verification token mismatch"
          }
        }
      },
      "post": {
        "tags": [
          "Webhooks"
        ],
        "operationId": "handle_inbound_webhook",
        "parameters": [
          {
            "name": "channel_id",
            "in": "path",
            "description": "Channel ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "",
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Inbound webhook acknowledged"
          },
          "403": {
            "description": "Invalid signature"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssignBranchesRequest": {
        "type": "object",
        "required": [
          "branch_ids"
        ],
        "properties": {
          "branch_ids": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BranchId"
            }
          }
        }
      },
      "AssignRolesRequest": {
        "type": "object",
        "required": [
          "role_names"
        ],
        "properties": {
          "role_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AuthTokens": {
        "type": "object",
        "required": [
          "access_token",
          "refresh_token",
          "token_type",
          "expires_in"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer",
            "format": "int64"
          },
          "refresh_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string"
          }
        }
      },
      "BranchDto": {
        "type": "object",
        "required": [
          "id",
          "tenant_id",
          "name",
          "code",
          "drap_licence_no",
          "pharmacist_in_charge",
          "address",
          "city",
          "is_hub",
          "cold_chain_capable",
          "status"
        ],
        "properties": {
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "cold_chain_capable": {
            "type": "boolean"
          },
          "drap_licence_no": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/BranchId"
          },
          "is_hub": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "pharmacist_in_charge": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "tenant_id": {
            "$ref": "#/components/schemas/TenantId"
          }
        }
      },
      "BranchId": {
        "type": "string",
        "format": "uuid",
        "example": "018f3a9e-4c5b-7b3a-9e1a-2b3c4d5e6f7a"
      },
      "CategoryId": {
        "type": "string",
        "format": "uuid",
        "example": "018f3a9e-4c5b-7b3a-9e1a-2b3c4d5e6f7a"
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "new_password": {
            "type": "string"
          }
        }
      },
      "CreateBranchRequest": {
        "type": "object",
        "required": [
          "name",
          "code",
          "drap_licence_no",
          "pharmacist_in_charge",
          "address",
          "city",
          "longitude",
          "latitude",
          "is_hub",
          "cold_chain_capable"
        ],
        "properties": {
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "cold_chain_capable": {
            "type": "boolean"
          },
          "drap_licence_no": {
            "type": "string"
          },
          "is_hub": {
            "type": "boolean"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "name": {
            "type": "string"
          },
          "pharmacist_in_charge": {
            "type": "string"
          }
        }
      },
      "CreateProductRequest": {
        "type": "object",
        "required": [
          "brand_name",
          "mrp",
          "is_prescription_only",
          "is_narcotic",
          "is_refrigerated"
        ],
        "properties": {
          "barcode": {
            "type": "string",
            "nullable": true
          },
          "brand_name": {
            "type": "string"
          },
          "category_id": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CategoryId"
              }
            ],
            "nullable": true
          },
          "cost_price": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Money"
              }
            ],
            "nullable": true
          },
          "dosage_form": {
            "type": "string",
            "nullable": true
          },
          "generic_name": {
            "type": "string",
            "nullable": true
          },
          "is_narcotic": {
            "type": "boolean"
          },
          "is_prescription_only": {
            "type": "boolean"
          },
          "is_refrigerated": {
            "type": "boolean"
          },
          "manufacturer": {
            "type": "string",
            "nullable": true
          },
          "mrp": {
            "$ref": "#/components/schemas/Money"
          },
          "pack_size": {
            "type": "string",
            "nullable": true
          },
          "strength": {
            "type": "string",
            "nullable": true
          },
          "tp": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Money"
              }
            ],
            "nullable": true
          }
        }
