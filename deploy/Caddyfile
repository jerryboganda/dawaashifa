# =================================================================================================
# Shifa Platform Single Domain Architecture (Caddy Reverse Proxy)
# Domain: dawaa.polytronx.com
# =================================================================================================

{
  admin off
}

:80 {
  encode gzip zstd

  # Security Hardening Headers (Doc 17 §11)
  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(self), microphone=(), geolocation=()"
    -Server
  }

  # 1. API Endpoints
  handle /api/* {
    reverse_proxy api:8080 {
      header_up X-Forwarded-Proto {scheme}
      header_up X-Real-IP {remote_host}
    }
  }

  # 2. WhatsApp Webhooks Ingress
  handle /webhooks/* {
    reverse_proxy api:8080 {
      header_up X-Forwarded-Proto {scheme}
      header_up X-Real-IP {remote_host}
    }
  }

  # 3. OpenAPI Documentation & Swagger UI
  handle /swagger-ui* {
    reverse_proxy api:8080
  }
  handle /api-docs/* {
    reverse_proxy api:8080
  }

  # 4. System Health Check
  handle /health {
    reverse_proxy api:8080
  }

  # 5. Operations & Pharmacist Console (SvelteKit)
  handle /ops* {
    reverse_proxy console:80 {
      header_up Host {host}
    }
  }

  # 6. Rider Delivery PWA
  handle /rider* {
    reverse_proxy rider:80 {
      header_up Host {host}
    }
  }

  # 7. Grafana Observability Dashboard
  handle /monitoring* {
    reverse_proxy grafana:3000
  }

  # 8. Public Pharmacy Portal & Marketing (Astro / Public Web)
  handle {
    reverse_proxy web:80 {
      header_up Host {host}
    }
  }
}
